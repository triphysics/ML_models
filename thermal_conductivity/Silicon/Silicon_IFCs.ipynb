   "source": [
    " # Setup plotting, seaborn is just used to make figures look a bit nicer not required\n",
    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "try:\n",
    "    import seaborn as sns\n",
    "    sns.set_context('talk')\n",
    "except ModuleNotFoundError:\n",
    "    print('Dont worry')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5e8bb44c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "from ase.io import read\n",
    "from ase.db import connect\n",
    "from hiphive import ClusterSpace, StructureContainer\n",
    "from hiphive.utilities import get_displacements\n",
    "from trainstation import Optimizer\n",
    "from hiphive import ClusterSpace, StructureContainer, ForceConstantPotential\n",
    "from phonopy import Phonopy\n",
    "from phonopy.structure.atoms import PhonopyAtoms\n",
    "from ase import Atoms"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d077da6a",
   "metadata": {},
   "source": [
    "Lets describe the cutoff paramters here. convergence should be check wrt to these parameters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "7b64cf75",
   "metadata": {},
   "outputs": [],
   "source": [
    "cutoffs = [6.65, 4.0, 2.5]\n",
    "cutoffs_str = str(cutoffs)[1:-1].replace(', ', '_')\n",
    "sc_fname = 'sc_cutoffs-{}.sc'.format(cutoffs_str)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1f80c86c",
   "metadata": {},
   "source": [
    "Setup cluster space and Structure Container. And Feed raw data training structures from DFT simulations which is stored as ase data base."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "687100c6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
